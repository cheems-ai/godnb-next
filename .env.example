# ===== 部署目标 =====
# vercel  → Vercel（默认，图片走 Vercel 全球 CDN 优化服务）
# cloudflare → Cloudflare Workers（output=standalone + @opennextjs/cloudflare 适配器）
NEXT_DEPLOY_TARGET=vercel

# ===== 站点 =====
NEXT_PUBLIC_SITE_NAME=God NB · Next.js
NEXT_PUBLIC_SITE_URL=https://godnb.com

# ===== 开发期调试：next/image 自动走原生加载，不依赖服务器端优化 =====
# NEXT_PUBLIC_IMAGE_UNOPTIMIZED=1

# ===== 第三方集成 =====
# （占位，真正使用时去对应平台申请，勿提交真实密钥）
# ANALYTICS_ID=G-XXXXXXXXXX
# RESEND_API_KEY=
# DATABASE_URL=
